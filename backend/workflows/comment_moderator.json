{
  "name": "comment moderator",
  "nodes": [
    {
      "parameters": {
        "queue": "https://sqs.ap-northeast-2.amazonaws.com/379355014195/comment-moderation-queue",
        "interval": 10,
        "unit": "minutes",
        "deleteMessages": true,
        "maxMessages": 10
      },
      "type": "CUSTOM.awsSqsExtendedTrigger",
      "typeVersion": 1,
